{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/american-english-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking spelling..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/standards-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking standards..."
          }
        ]
      }
    ]
  }
}
